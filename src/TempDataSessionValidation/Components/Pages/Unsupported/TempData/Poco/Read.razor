@page "/unsupported/tempdata/poco/read"

<PageTitle>TempData Unsupported POCO Reader</PageTitle>

<h1>Read TempData unsupported POCO</h1>

<div class="alert alert-warning">
    Reaching this markup means that the component was able to begin rendering.
    Inspect the browser and terminal for a rejection diagnostic.
</div>

<dl class="row">
    <dt class="col-sm-3">Property</dt>
    <dd class="col-sm-9">TempDataPoco</dd>

    <dt class="col-sm-3">Declared type</dt>
    <dd class="col-sm-9">
        <code>TempDataSessionValidation.Models.ValidationPoco</code>
    </dd>

    <dt class="col-sm-3">Observed value</dt>
    <dd class="col-sm-9">@FormatValue(TempDataPoco)</dd>

    <dt class="col-sm-3">Runtime type</dt>
    <dd class="col-sm-9">
        <code>@GetRuntimeType(TempDataPoco)</code>
    </dd>
</dl>

<a href="/unsupported/tempdata/poco/set"
   class="btn btn-outline-primary"
   data-enhance-nav="false">
    Set TempData POCO again
</a>

@code {
    [SupplyParameterFromTempData(Name = "Unsupported.TempData.Poco")]
    public ValidationPoco? TempDataPoco { get; set; }

    private static string FormatValue(object? value)
        => value?.ToString() ?? "<null>";

    private static string GetRuntimeType(object? value)
        => value?.GetType().FullName ?? "<null>";
}