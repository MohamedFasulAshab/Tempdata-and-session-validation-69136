@code {
    [SupplyParameterFromSession(Name = "Unsupported.Session.Poco")]
    public ValidationPoco? SessionPoco { get; set; }

    protected override void OnInitialized()
    {
        SessionPoco = new ValidationPoco
        {
            Id = 301,
            Name = "Session POCO",
            IsActive = true
        };
    }
}
